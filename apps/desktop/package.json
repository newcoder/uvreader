{
  "name": "qiaomu-reader-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone Electron shell for UV Reader.",
  "main": "dist/main.cjs",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
