{
  "name": "qiaomu-reader-desktop",
  "private": true,
  "version": "0.9.65",
  "description": "Standalone Electron shell for UV Reader (纽扣).",
  "author": "newcoder",
  "main": "dist/main.cjs",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "start": "electron .",
    "smoke": "node scripts/smoke.mjs",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "build:logo": "electron scripts/import-logo.cjs",
    "e2e": "node build.mjs && node scripts/e2e.mjs",
    "dist": "node build.mjs --production && electron-builder --config electron-builder.config.cjs --publish never",
    "store": "node build.mjs --production && electron-builder --config electron-builder.store.cjs --publish never",
    "dist:dir": "node build.mjs --production && electron-builder --config electron-builder.config.cjs --publish never --dir",
    "test": "node --test test/*.test.mjs",
    "matrix": "node scripts/convert-matrix.mjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.1",
    "playwright-core": "^1.63.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@earendil-works/pi-ai": "0.85.1",
    "marked": "^18.0.13",
    "opencc-js": "^1.4.2"
  }
}
