{
  "name": "uvreader",
  "version": "0.1.0",
  "description": "中文优先的独立桌面阅读器，支持 EPUB、PDF、FB2、MOBI、AZW3 与 CBZ，含划线、批注、阅读笔记和可选 AI 伴读。",
  "type": "module",
  "scripts": {
    "postinstall": "node patch-pdfjs.cjs",
    "test": "node --test tests/*.test.mjs",
    "test:shim": "node --test packages/host-shim/test/*.test.mjs",
    "test:desktop": "node --test apps/desktop/test/*.test.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "build:books": "node scripts/build-starter-books.mjs",
    "desktop:install": "npm --prefix apps/desktop install",
    "desktop:build": "npm --prefix apps/desktop run build",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:start": "npm --prefix apps/desktop run start",
    "desktop:smoke": "npm --prefix apps/desktop run smoke",
    "desktop:e2e": "npm --prefix apps/desktop run e2e",
    "desktop:dist": "npm --prefix apps/desktop run dist",
    "desktop:dist:dir": "npm --prefix apps/desktop run dist:dir",
    "desktop:smoke:packaged": "npm --prefix apps/desktop run smoke:packaged",
    "build:icon": "node scripts/make-app-icon.mjs"
  },
  "keywords": [
    "reader",
    "epub",
    "pdf",
    "fb2",
    "mobi",
    "azw3",
    "cbz",
    "electron",
    "desktop"
  ],
  "author": "newcoder",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "jsdom": "^29.1.1"
  },
  "dependencies": {
    "foliate-js": "^1.0.1",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "pdfjs-dist": "^6.2.108"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.9.12",
    "minimatch@3.1.5": {
      "brace-expansion": "2.0.2"
    },
    "tar": "^7.5.22"
  }
}
